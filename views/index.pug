//- index.pug
doctype html
html(lang="da")
    head
        title Chat
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Chats
        if user
            button#vis-opret-chat Opret chat
            dialog#opret-chat-dialog
                form#opret-chat-form
                    h3 Ny chat
                    input#chatName(type="text" placeholder="Navn på chat" required)
                    button(type="submit") Opret chat
                    button#luk-dialog(type="button") Annuler
        ul
            each chat in chats
                li
                    a(href="/chats/" + chat.id)= chat.name

                    if user && user.accessLevel >= 2 && (chat.owner === user.id || user.accessLevel === 3)
                        button.rediger Rediger
                        button.slet Slet

        if user
            p Logget ind som #{user.username} (niveau #{user.accessLevel})
            button#logout Log ud!
        else
            form#login-form
                input#username(type="text" placeholder="Brugernavn" required)
                input#password(type="password" placeholder="Adgangskode" required)
                button(type="submit") Log ind
            p#loginFejl

            form#opret-form
                input#opretUsername(type="text" placeholder="Brugernavn" required)
                input#opretPassword(type="password" placeholder="Adgangskode" required)
                input#opretLevel(type="range" min="1" max="3" step="1" value="1" required)
                button(type="submit") Opret
            p#fejl
        if user && user.accessLevel === 3
            h2 Alle registrerede brugere
            ul
                each u in users
                    li= u.username
    script(src="/js/main.js")